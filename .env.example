# Настройки языковой модели для планировщика (ключ --llm http). Скопируйте файл в .env и заполните.
# Файл .env в репозиторий не попадает. Без него всё работает: --llm mock (имитатор) и --llm ollama (локальная Qwen).
#
#   pixi run python -m did.llm --kind http      # проверить, что модель отвечает
#   pixi run run --level medium --seed 1001 --agent adaptive_llm --llm http

# Адрес сервера с интерфейсом, совместимым с OpenAI, без /chat/completions на конце.
# Для моделей МАИ: https://api-ai.mai.ru/v1
DID_LLM_BASE_URL=
DID_LLM_API_KEY=
# Имя модели, как его называет сервер. На api-ai.mai.ru: qwen3.8-flash-next, qwen3.8-27b, qwen3.6-35b-a3b,
# Qwen3.5-122B-A10B, deepseek-v4.1-flash, DeepSeek-V4-Flash
DID_LLM_MODEL=

# Необязательные
# DID_LLM_TIMEOUT_S=30
# DID_LLM_MAX_RETRIES=2
# DID_LLM_JSON_MODE=1
# DID_LLM_JSON_SCHEMA=1        # слать схему ответа: модели МАИ её поддерживают
# DID_LLM_MIN_TOKENS=3000       # запас на рассуждение: без него ответ рассуждающей модели обрывается
# DID_LLM_EXTRA_BODY={"enable_thinking": false}

# Локальная модель через Ollama (ключ --llm ollama); по умолчанию http://127.0.0.1:11434/v1 и qwen2.5:3b
# DID_OLLAMA_URL=
# DID_OLLAMA_MODEL=
